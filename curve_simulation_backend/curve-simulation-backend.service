[Unit]
Description=Curve Simulation Backend API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/curve_simulation_backend
Environment="PATH=/home/ubuntu/curve_simulation_backend/venv/bin"
EnvironmentFile=/home/ubuntu/curve_simulation_backend/.env
ExecStart=/home/ubuntu/curve_simulation_backend/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
