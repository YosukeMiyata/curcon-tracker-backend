[Unit]
Description=USD/JPY OHLC Data Aggregator
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/curcon-tracker
Environment="PATH=/usr/bin:/usr/local/bin:/home/ubuntu/.local/bin"
EnvironmentFile=/home/ubuntu/convex-scraper/.env
ExecStart=/usr/bin/python3 /home/ubuntu/curcon-tracker/data_acquisition_system/usdjpy_price_tracker/usdjpy_ohlc_aggregator.py
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

